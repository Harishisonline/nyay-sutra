# Copy to apps/api/.env. Every value below is optional in development: without keys the API runs
# with local OTP, SQLite, embedded Qdrant and the offline extractive answerer. Production refuses
# to boot without Supabase auth and at least one LLM key (see hermestodo.md).

APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# Supabase Postgres (production). Leave unset for SQLite at apps/api/data/nyay.db.
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# DB_AUTO_CREATE=false

# Auth: auto picks supabase when SUPABASE_URL + SUPABASE_ANON_KEY are set, otherwise local dev OTP.
AUTH_BACKEND=auto
JWT_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Server-side only. Never expose to the web app.
SUPABASE_SERVICE_KEY=

# LLM: Groq primary, Gemini fallback (both free tier).
# llama-3.3-70b-versatile is no longer on Groq's free model list. Default is openai/gpt-oss-120b.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
ALLOW_OFFLINE_LLM=true

# Embeddings: local sentence-transformers, or the HF Inference API when local is unavailable
EMBEDDINGS_BACKEND=auto
HUGGINGFACE_API_KEY=

# Qdrant Cloud free tier. Leave unset for embedded local mode at apps/api/data/qdrant.
QDRANT_URL=
QDRANT_API_KEY=

# Optional ONNX DistilBERT reranker exported by ml/train_distilbert.ipynb
RERANKER_PATH=

# Bhashini (voice)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
