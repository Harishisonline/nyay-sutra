# FastAPI backend base URL. The browser never calls it directly: every
# browser request goes through the same-origin proxy at /api/v1/*, which
# attaches the session cookie as a Bearer token.
API_URL=http://localhost:8000

# Public site URL, used for metadata and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Shown on /settings/about once they exist.
# NEXT_PUBLIC_REPO_URL=https://github.com/<owner>/nyay-sutra
# NEXT_PUBLIC_CONTACT_EMAIL=team@example.org
